
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "workers/index.ts",
  "compatibility_date": "2026-11-03",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "NOVA_CHANNELS",
        "class_name": "ChannelRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChannelRoom"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-db",
      "database_id": "98b364da-e04d-43f7-a332-6ec29b43c4d5"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "nova-media"
    }
  ],

  "vars": {
    "ALLOWED_ORIGIN": "https://chat.rwscorch.workers.dev",
    "TURN_URL": "",
    "TURN_USERNAME": "",
    "TURN_CREDENTIAL": ""
  }
}
